{
  "concept": "canary-deployments",
  "authored": "2026-10-20",
  "sources": [
    {
      "title": "Google SRE Workbook \u2014 Canarying Releases",
      "url": "https://sre.google/workbook/canarying-releases/",
      "retrieved": "2026-10-19"
    },
    {
      "title": "Argo Rollouts \u2014 Analysis and Progressive Delivery",
      "url": "https://argo-rollouts.readthedocs.io/en/stable/features/analysis/",
      "retrieved": "2026-10-19"
    },
    {
      "title": "Argo Rollouts \u2014 Canary Deployment Strategy",
      "url": "https://argo-rollouts.readthedocs.io/en/stable/features/canary/",
      "retrieved": "2026-10-19"
    },
    {
      "title": "Amazon Builders\u2019 Library \u2014 Ensuring rollback safety during deployments",
      "url": "https://aws.amazon.com/builders-library/ensuring-rollback-safety-during-deployments/",
      "retrieved": "2026-10-19"
    }
  ],
  "lessons": [
    {
      "title": "Keep a control version",
      "nodes": [
        {
          "id": "router",
          "label": "TRAFFIC ROUTER",
          "state": ""
        },
        {
          "id": "old",
          "label": "CURRENT v1",
          "state": "stable"
        },
        {
          "id": "new",
          "label": "CANDIDATE v2",
          "state": "unproven"
        },
        {
          "id": "m",
          "label": "MEASUREMENTS",
          "state": ""
        }
      ],
      "intro": "A canary deploys a candidate to limited traffic while the current version remains as a control. The comparison must influence the rollout decision.",
      "takeaway": "A slow rollout alone is not an evaluation. Define which outcomes will cause promotion, pause or abort.",
      "duration": 28,
      "beats": [
        {
          "lines": [
            "Version 1 is serving the application.",
            "Version 2 is a candidate change."
          ],
          "actions": [],
          "time": 0
        },
        {
          "lines": [
            "Keep the current version as a control.",
            "It gives the candidate a comparison."
          ],
          "actions": [
            {
              "type": "send",
              "to": "old",
              "label": "REQUEST",
              "delay": 0,
              "from": "router"
            },
            {
              "type": "state",
              "node": "old",
              "text": "control",
              "color": "ok",
              "delay": 2
            }
          ],
          "time": 7
        },
        {
          "lines": [
            "Send limited traffic to the candidate.",
            "Observe its behavior before expanding."
          ],
          "actions": [
            {
              "type": "send",
              "to": "new",
              "label": "REQUEST",
              "delay": 0,
              "from": "router"
            },
            {
              "type": "state",
              "node": "new",
              "text": "candidate",
              "color": "accent",
              "delay": 0
            }
          ],
          "time": 14
        },
        {
          "lines": [
            "Compare results from both versions.",
            "The result must change a rollout decision."
          ],
          "actions": [
            {
              "type": "send",
              "to": "m",
              "label": "v1 RESULTS",
              "delay": 0,
              "from": "old"
            },
            {
              "type": "send",
              "to": "m",
              "label": "v2 RESULTS",
              "delay": 3,
              "from": "new"
            }
          ],
          "time": 21
        }
      ]
    },
    {
      "title": "Limit the exposure",
      "nodes": [
        {
          "id": "router",
          "label": "TRAFFIC ROUTER",
          "state": "10,000 requests"
        },
        {
          "id": "old",
          "label": "CURRENT v1",
          "state": ""
        },
        {
          "id": "new",
          "label": "CANDIDATE v2",
          "state": ""
        },
        {
          "id": "m",
          "label": "REQUEST COUNTS",
          "state": ""
        }
      ],
      "intro": "In this example, the candidate receives ten percent of traffic: 1,000 of 10,000 requests. The other 9,000 stay on the current version.",
      "takeaway": "The percentages describe this illustrative window. A small share limits exposure, but can still harm affected users.",
      "duration": 28,
      "beats": [
        {
          "lines": [
            "This window has 10,000 requests.",
            "The candidate receives a ten-percent share."
          ],
          "actions": [],
          "time": 0
        },
        {
          "lines": [
            "9,000 requests go to version 1.",
            "Most traffic stays on the control."
          ],
          "actions": [
            {
              "type": "send",
              "to": "old",
              "label": "9,000",
              "delay": 0,
              "from": "router"
            },
            {
              "type": "state",
              "node": "old",
              "text": "9,000 requests",
              "color": "ok",
              "delay": 2
            }
          ],
          "time": 7
        },
        {
          "lines": [
            "1,000 requests go to version 2.",
            "The candidate has limited exposure."
          ],
          "actions": [
            {
              "type": "send",
              "to": "new",
              "label": "1,000",
              "delay": 0,
              "from": "router"
            },
            {
              "type": "state",
              "node": "new",
              "text": "1,000 requests",
              "color": "accent",
              "delay": 2
            }
          ],
          "time": 14
        },
        {
          "lines": [
            "Measure each version separately.",
            "A small rollout is not proof of safety."
          ],
          "actions": [
            {
              "type": "send",
              "to": "m",
              "label": "v2 COUNTS",
              "delay": 0,
              "from": "new"
            },
            {
              "type": "state",
              "node": "m",
              "text": "compare versions",
              "color": "accent",
              "delay": 0
            }
          ],
          "time": 21
        }
      ]
    },
    {
      "title": "An average hides failure",
      "nodes": [
        {
          "id": "all",
          "label": "ALL REQUESTS",
          "state": "10,000 total"
        },
        {
          "id": "v2",
          "label": "CANDIDATE",
          "state": "1,000 requests"
        },
        {
          "id": "export",
          "label": "v2 EXPORTS",
          "state": "100 requests"
        }
      ],
      "intro": "Forty candidate exports fail. Everything else succeeds. Across all traffic that is 40 out of 10,000, or 0.4%, but the affected operation is much worse.",
      "takeaway": "Aggregate rates can conceal failures concentrated in a small version-and-operation slice.",
      "duration": 28,
      "beats": [
        {
          "lines": [
            "There are 10,000 total requests.",
            "Only 100 are exports handled by v2."
          ],
          "actions": [],
          "time": 0
        },
        {
          "lines": [
            "Forty candidate exports fail.",
            "The other requests succeed."
          ],
          "actions": [
            {
              "type": "state",
              "node": "export",
              "text": "40 failures",
              "color": "bad",
              "delay": 0
            }
          ],
          "time": 7
        },
        {
          "lines": [
            "Overall: 40 failures out of 10,000.",
            "The headline error rate is only 0.4%."
          ],
          "actions": [
            {
              "type": "send",
              "to": "all",
              "label": "40 FAILURES",
              "delay": 0,
              "from": "export"
            },
            {
              "type": "state",
              "node": "all",
              "text": "0.4% errors",
              "color": "accent",
              "delay": 2
            }
          ],
          "time": 14
        },
        {
          "lines": [
            "An overall 1% alert would stay quiet.",
            "Split the results before judging safety."
          ],
          "actions": [],
          "time": 21
        }
      ]
    },
    {
      "title": "Compare the same operation",
      "nodes": [
        {
          "id": "old",
          "label": "v1 EXPORTS",
          "state": "900 requests"
        },
        {
          "id": "new",
          "label": "v2 EXPORTS",
          "state": "100 requests"
        },
        {
          "id": "decision",
          "label": "ROLLOUT DECISION",
          "state": ""
        }
      ],
      "intro": "Compare export requests on the candidate with export requests on the control. Candidate exports fail 40 out of 100 times; control exports fail zero out of 900.",
      "takeaway": "The 40% candidate-export failure rate is relevant to this rollout. These authored counts are not real benchmark results.",
      "duration": 28,
      "beats": [
        {
          "lines": [
            "Compare exports with exports.",
            "Do not mix them with unrelated requests."
          ],
          "actions": [],
          "time": 0
        },
        {
          "lines": [
            "Version 1: zero failures out of 900.",
            "Control exports have a 0% error rate."
          ],
          "actions": [
            {
              "type": "state",
              "node": "old",
              "text": "0 / 900 fail",
              "color": "ok",
              "delay": 0
            }
          ],
          "time": 7
        },
        {
          "lines": [
            "Version 2: 40 failures out of 100.",
            "Candidate exports have a 40% error rate."
          ],
          "actions": [
            {
              "type": "state",
              "node": "new",
              "text": "40 / 100 fail",
              "color": "bad",
              "delay": 0
            }
          ],
          "time": 14
        },
        {
          "lines": [
            "The candidate has a clear regression.",
            "The comparison argues against promotion."
          ],
          "actions": [
            {
              "type": "send",
              "to": "decision",
              "label": "40% ERRORS",
              "delay": 0,
              "from": "new"
            },
            {
              "type": "state",
              "node": "decision",
              "text": "do not promote",
              "color": "bad",
              "delay": 2
            }
          ],
          "time": 21
        }
      ]
    },
    {
      "title": "Abort and verify recovery",
      "nodes": [
        {
          "id": "router",
          "label": "TRAFFIC ROUTER",
          "state": ""
        },
        {
          "id": "old",
          "label": "CURRENT v1",
          "state": "stable"
        },
        {
          "id": "new",
          "label": "CANDIDATE v2",
          "state": "regression"
        },
        {
          "id": "m",
          "label": "RECOVERY CHECK",
          "state": ""
        }
      ],
      "intro": "After detecting the regression, stop sending new traffic to the candidate and verify the current version can safely resume the load.",
      "takeaway": "Rerouting new requests does not undo completed writes or guarantee schema compatibility. Rollback safety needs separate planning.",
      "duration": 28,
      "beats": [
        {
          "lines": [
            "The candidate fails the release check.",
            "Stop increasing its share."
          ],
          "actions": [
            {
              "type": "state",
              "node": "new",
              "text": "promotion stopped",
              "color": "bad",
              "delay": 0
            }
          ],
          "time": 0
        },
        {
          "lines": [
            "Route new requests to the control.",
            "The candidate receives no new traffic."
          ],
          "actions": [
            {
              "type": "send",
              "to": "old",
              "label": "NEW REQUESTS",
              "delay": 0,
              "from": "router"
            },
            {
              "type": "state",
              "node": "new",
              "text": "0% new traffic",
              "color": "bad",
              "delay": 2
            }
          ],
          "time": 7
        },
        {
          "lines": [
            "Check the recovered service behavior.",
            "Do not assume abort means healthy."
          ],
          "actions": [
            {
              "type": "send",
              "to": "m",
              "label": "RESULTS",
              "delay": 0,
              "from": "old"
            },
            {
              "type": "work",
              "node": "m",
              "duration": 3,
              "delay": 2
            }
          ],
          "time": 14
        },
        {
          "lines": [
            "Confirm recovery before concluding.",
            "Data changes may need separate repair."
          ],
          "actions": [
            {
              "type": "state",
              "node": "m",
              "text": "verify recovery",
              "color": "accent",
              "delay": 0
            }
          ],
          "time": 21
        }
      ]
    }
  ]
}
