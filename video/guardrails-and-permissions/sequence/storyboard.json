{
  "concept": "guardrails-and-permissions",
  "authored": "2026-10-20",
  "sources": [
    {
      "title": "OWASP: Authorization \u2014 least privilege, default deny, checks on every request",
      "url": "https://cheatsheetseries.owasp.org/cheatsheets/Authorization_Cheat_Sheet.html",
      "retrieved": "2026-10-19"
    },
    {
      "title": "OWASP: LLM Prompt Injection Prevention \u2014 tool defenses and guardrail limitations",
      "url": "https://cheatsheetseries.owasp.org/cheatsheets/LLM_Prompt_Injection_Prevention_Cheat_Sheet.html",
      "retrieved": "2026-10-19"
    },
    {
      "title": "OWASP: Transaction Authorization \u2014 bind approval to significant action data",
      "url": "https://cheatsheetseries.owasp.org/cheatsheets/Transaction_Authorization_Cheat_Sheet.html",
      "retrieved": "2026-10-19"
    },
    {
      "title": "MCP tools specification (2025-06-18): implementation responsibilities",
      "url": "https://modelcontextprotocol.io/specification/2025-06-18/server/tools",
      "retrieved": "2026-10-19"
    },
    {
      "title": "GitHub Actions: deployment protection rules and environment secrets",
      "url": "https://docs.github.com/en/actions/reference/workflows-and-actions/deployments-and-environments",
      "retrieved": "2026-10-19"
    }
  ],
  "lessons": [
    {
      "title": "Intent versus permission",
      "nodes": [
        {
          "id": "agent",
          "label": "AGENT",
          "state": "read-only task"
        },
        {
          "id": "auth",
          "label": "AUTHORIZATION",
          "state": ""
        },
        {
          "id": "deploy",
          "label": "DEPLOY SERVICE",
          "state": ""
        }
      ],
      "intro": "An instruction says what an agent should do. Authorization determines whether its identity is allowed to perform the requested operation on the resource.",
      "takeaway": "Enforce important boundaries in the application or service. A persistent instruction cannot replace an authorization check.",
      "duration": 28,
      "beats": [
        {
          "lines": [
            "The agent is told not to deploy.",
            "That instruction expresses the policy."
          ],
          "actions": [],
          "time": 0
        },
        {
          "lines": [
            "Suppose it still requests deployment.",
            "The service must check its identity."
          ],
          "actions": [
            {
              "type": "send",
              "to": "auth",
              "label": "DEPLOY REQUEST",
              "delay": 0,
              "from": "agent"
            }
          ],
          "time": 7
        },
        {
          "lines": [
            "This identity has no deploy permission.",
            "Authorization rejects the operation."
          ],
          "actions": [
            {
              "type": "state",
              "node": "auth",
              "text": "not authorized",
              "color": "bad",
              "delay": 0
            }
          ],
          "time": 14
        },
        {
          "lines": [
            "The deploy service is never invoked.",
            "Enforce access outside the model."
          ],
          "actions": [
            {
              "type": "state",
              "node": "deploy",
              "text": "not executed",
              "color": "accent",
              "delay": 0
            }
          ],
          "time": 21
        }
      ]
    },
    {
      "title": "Grant only needed access",
      "nodes": [
        {
          "id": "agent",
          "label": "INCIDENT AGENT",
          "state": ""
        },
        {
          "id": "auth",
          "label": "AUTHORIZATION",
          "state": ""
        },
        {
          "id": "logs",
          "label": "APPROVED LOGS",
          "state": ""
        }
      ],
      "intro": "An incident investigation needs access to particular service logs. Give the investigating identity only the operations and resources required.",
      "takeaway": "Least privilege applies to both action and resource. A read capability should not implicitly grant deployment or unrelated data access.",
      "duration": 28,
      "beats": [
        {
          "lines": [
            "The agent needs checkout service logs.",
            "Its identity is allowed to read that scope."
          ],
          "actions": [],
          "time": 0
        },
        {
          "lines": [
            "The service checks this read request.",
            "Permission applies to action and resource."
          ],
          "actions": [
            {
              "type": "send",
              "to": "auth",
              "label": "READ checkout",
              "delay": 0,
              "from": "agent"
            }
          ],
          "time": 7
        },
        {
          "lines": [
            "The approved read is executed.",
            "The permitted logs can be returned."
          ],
          "actions": [
            {
              "type": "send",
              "to": "logs",
              "label": "ALLOWED READ",
              "delay": 0,
              "from": "auth"
            },
            {
              "type": "state",
              "node": "logs",
              "text": "read permitted",
              "color": "ok",
              "delay": 2
            }
          ],
          "time": 14
        },
        {
          "lines": [
            "A read of payments logs is different.",
            "This identity lacks that permission."
          ],
          "actions": [
            {
              "type": "send",
              "to": "auth",
              "label": "READ payments",
              "delay": 0,
              "from": "agent"
            },
            {
              "type": "state",
              "node": "auth",
              "text": "payments denied",
              "color": "bad",
              "delay": 2
            }
          ],
          "time": 21
        }
      ]
    },
    {
      "title": "Policy and permission",
      "nodes": [
        {
          "id": "agent",
          "label": "PROPOSED ACTION",
          "state": ""
        },
        {
          "id": "guard",
          "label": "POLICY CHECK",
          "state": ""
        },
        {
          "id": "auth",
          "label": "AUTHORIZATION",
          "state": ""
        }
      ],
      "intro": "Guardrails can include deterministic validation and model-based judgments. Their reliability differs. Authorization should still be checked for every execution.",
      "takeaway": "A guardrail pass is not a security guarantee. Keep identity-based permission enforcement at the action boundary.",
      "duration": 28,
      "beats": [
        {
          "lines": [
            "A proposed action enters a policy check.",
            "Some checks involve fallible judgments."
          ],
          "actions": [
            {
              "type": "send",
              "to": "guard",
              "label": "PROPOSAL",
              "delay": 0,
              "from": "agent"
            }
          ],
          "time": 0
        },
        {
          "lines": [
            "The policy check accepts the proposal.",
            "That result alone does not grant access."
          ],
          "actions": [
            {
              "type": "state",
              "node": "guard",
              "text": "policy pass",
              "color": "accent",
              "delay": 0
            }
          ],
          "time": 7
        },
        {
          "lines": [
            "Authorization still checks the operation.",
            "The identity lacks the required permission."
          ],
          "actions": [
            {
              "type": "send",
              "to": "auth",
              "label": "CHECK ACCESS",
              "delay": 0,
              "from": "guard"
            },
            {
              "type": "state",
              "node": "auth",
              "text": "permission denied",
              "color": "bad",
              "delay": 2
            }
          ],
          "time": 14
        },
        {
          "lines": [
            "Do not execute the unauthorized action.",
            "A guardrail pass cannot override this check."
          ],
          "actions": [],
          "time": 21
        }
      ]
    },
    {
      "title": "Review a concrete action",
      "nodes": [
        {
          "id": "agent",
          "label": "AGENT",
          "state": "release r42"
        },
        {
          "id": "review",
          "label": "HUMAN REVIEW",
          "state": ""
        },
        {
          "id": "exec",
          "label": "DEPLOY EXECUTOR",
          "state": ""
        }
      ],
      "intro": "The agent can propose a release without holding production credentials. A reviewer checks the exact artifact, target and supporting evidence.",
      "takeaway": "Approval must refer to the action actually executed. A separate executor enforces that binding.",
      "duration": 28,
      "beats": [
        {
          "lines": [
            "The agent prepares release r42.",
            "Its proposal names the production target."
          ],
          "actions": [],
          "time": 0
        },
        {
          "lines": [
            "Send the artifact and test evidence.",
            "The reviewer can inspect a concrete action."
          ],
          "actions": [
            {
              "type": "send",
              "to": "review",
              "label": "r42 + EVIDENCE",
              "delay": 0,
              "from": "agent"
            },
            {
              "type": "state",
              "node": "review",
              "text": "r42; prod; tests pass",
              "color": "ok",
              "delay": 2
            }
          ],
          "time": 7
        },
        {
          "lines": [
            "The reviewer approves that exact release.",
            "The executor checks artifact and target."
          ],
          "actions": [
            {
              "type": "send",
              "to": "exec",
              "label": "APPROVE r42",
              "delay": 0,
              "from": "review"
            },
            {
              "type": "state",
              "node": "exec",
              "text": "check approval",
              "color": "accent",
              "delay": 2
            }
          ],
          "time": 14
        },
        {
          "lines": [
            "Only the authorized action proceeds.",
            "The agent itself stays read-only."
          ],
          "actions": [
            {
              "type": "state",
              "node": "exec",
              "text": "deployed r42 to prod",
              "color": "ok",
              "delay": 0
            },
            {
              "type": "state",
              "node": "agent",
              "text": "still read-only",
              "color": "accent",
              "delay": 0
            }
          ],
          "time": 21
        }
      ]
    },
    {
      "title": "Recheck changed actions",
      "nodes": [
        {
          "id": "proposal",
          "label": "NEW PROPOSAL",
          "state": "release r43"
        },
        {
          "id": "approval",
          "label": "SAVED APPROVAL",
          "state": "release r42"
        },
        {
          "id": "exec",
          "label": "DEPLOY EXECUTOR",
          "state": ""
        }
      ],
      "intro": "An approval for r42 does not authorize a later r43 artifact. The executor compares the current action with the approved one.",
      "takeaway": "Bind authorization to significant action data and recheck it at execution time. Changed intent requires a new decision.",
      "duration": 28,
      "beats": [
        {
          "lines": [
            "The saved approval names release r42.",
            "The proposed artifact is now r43."
          ],
          "actions": [],
          "time": 0
        },
        {
          "lines": [
            "The executor receives the new proposal.",
            "It checks the stored approval."
          ],
          "actions": [
            {
              "type": "send",
              "to": "exec",
              "label": "r43",
              "delay": 0,
              "from": "proposal"
            },
            {
              "type": "send",
              "to": "exec",
              "label": "APPROVED r42",
              "delay": 3,
              "from": "approval"
            }
          ],
          "time": 7
        },
        {
          "lines": [
            "The artifact identifiers do not match.",
            "The executor blocks the changed action."
          ],
          "actions": [
            {
              "type": "state",
              "node": "exec",
              "text": "mismatch: blocked",
              "color": "bad",
              "delay": 0
            }
          ],
          "time": 14
        },
        {
          "lines": [
            "Get review for the actual new artifact.",
            "Do not reuse approval for different work."
          ],
          "actions": [],
          "time": 21
        }
      ]
    }
  ]
}
