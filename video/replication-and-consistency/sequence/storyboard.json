{
  "concept": "replication-and-consistency",
  "authored": "2026-10-20",
  "sources": [
    {
      "title": "PostgreSQL 18: Log-Shipping Standby Servers, \u00a7\u00a726.2.5 and 26.2.8",
      "url": "https://www.postgresql.org/docs/18/warm-standby.html",
      "retrieved": "2026-10-19"
    },
    {
      "title": "PostgreSQL 18: Write Ahead Log, synchronous_commit and Table 19.1",
      "url": "https://www.postgresql.org/docs/18/runtime-config-wal.html",
      "retrieved": "2026-10-19"
    },
    {
      "title": "PostgreSQL 18: Transaction Isolation, Read Committed and Repeatable Read",
      "url": "https://www.postgresql.org/docs/18/transaction-iso.html",
      "retrieved": "2026-10-19"
    }
  ],
  "lessons": [
    {
      "title": "Keep another copy",
      "nodes": [
        {
          "id": "app",
          "label": "APPLICATION",
          "state": ""
        },
        {
          "id": "p",
          "label": "PRIMARY",
          "state": "revision 7"
        },
        {
          "id": "r",
          "label": "REPLICA",
          "state": "revision 7"
        }
      ],
      "intro": "Replication maintains another copy of stored data. In this single-writer example the application writes to the primary.",
      "takeaway": "A replica is another data copy. Keeping it updated requires data to travel and be applied.",
      "duration": 28,
      "beats": [
        {
          "lines": [
            "The primary stores application data.",
            "The replica holds another copy."
          ],
          "actions": [],
          "time": 0
        },
        {
          "lines": [
            "A change is written to the primary.",
            "The primary now has revision 8."
          ],
          "actions": [
            {
              "type": "send",
              "to": "p",
              "label": "WRITE v8",
              "delay": 0,
              "from": "app"
            },
            {
              "type": "state",
              "node": "p",
              "text": "revision 8",
              "color": "ok",
              "delay": 2
            }
          ],
          "time": 7
        },
        {
          "lines": [
            "The change travels to the replica.",
            "The replica must apply it."
          ],
          "actions": [
            {
              "type": "send",
              "to": "r",
              "label": "CHANGE v8",
              "delay": 0,
              "from": "p"
            },
            {
              "type": "work",
              "node": "r",
              "duration": 3,
              "delay": 2
            }
          ],
          "time": 14
        },
        {
          "lines": [
            "The replica reaches revision 8.",
            "Both copies now contain the change."
          ],
          "actions": [
            {
              "type": "state",
              "node": "r",
              "text": "revision 8",
              "color": "ok",
              "delay": 0
            }
          ],
          "time": 21
        }
      ]
    },
    {
      "title": "A replica can lag",
      "nodes": [
        {
          "id": "app",
          "label": "APPLICATION",
          "state": ""
        },
        {
          "id": "p",
          "label": "PRIMARY",
          "state": "revision 8"
        },
        {
          "id": "r",
          "label": "REPLICA",
          "state": "revision 7"
        }
      ],
      "intro": "With asynchronous replication, the primary can acknowledge a write while the replica is behind. A read from that replica can return old data.",
      "takeaway": "A stale read does not prove the write failed. It tells you which data that particular reader observed.",
      "duration": 28,
      "beats": [
        {
          "lines": [
            "The primary has saved revision 8.",
            "The replica is still at revision 7."
          ],
          "actions": [],
          "time": 0
        },
        {
          "lines": [
            "The application reads the replica.",
            "That query sees the older revision."
          ],
          "actions": [
            {
              "type": "send",
              "to": "r",
              "label": "READ",
              "delay": 0,
              "from": "app"
            }
          ],
          "time": 7
        },
        {
          "lines": [
            "Revision 7 comes back successfully.",
            "The read is stale, not a failed write."
          ],
          "actions": [
            {
              "type": "send",
              "to": "app",
              "label": "v7",
              "delay": 0,
              "from": "r"
            },
            {
              "type": "state",
              "node": "app",
              "text": "observed v7",
              "color": "accent",
              "delay": 2
            }
          ],
          "time": 14
        },
        {
          "lines": [
            "The primary still holds revision 8.",
            "Different copies can answer differently."
          ],
          "actions": [],
          "time": 21
        }
      ]
    },
    {
      "title": "Check the revision you need",
      "nodes": [
        {
          "id": "app",
          "label": "APPLICATION",
          "state": "expects revision 8"
        },
        {
          "id": "p",
          "label": "PRIMARY",
          "state": "revision 8"
        },
        {
          "id": "r",
          "label": "REPLICA",
          "state": "revision 7"
        }
      ],
      "intro": "A release assistant needs to verify its own change. It checks the returned application revision rather than treating any successful response as confirmation.",
      "takeaway": "In this example, a fresh primary query sees the saved revision. Transaction snapshots and concurrent writers still matter in real systems.",
      "duration": 28,
      "beats": [
        {
          "lines": [
            "The verification expects revision 8.",
            "A replica response says revision 7."
          ],
          "actions": [
            {
              "type": "send",
              "to": "app",
              "label": "v7",
              "delay": 0,
              "from": "r"
            },
            {
              "type": "state",
              "node": "app",
              "text": "v7 \u2260 expected v8",
              "color": "bad",
              "delay": 2
            }
          ],
          "time": 0
        },
        {
          "lines": [
            "Use a fresh read from the primary.",
            "Verify against the required revision."
          ],
          "actions": [
            {
              "type": "send",
              "to": "p",
              "label": "READ",
              "delay": 0,
              "from": "app"
            }
          ],
          "time": 7
        },
        {
          "lines": [
            "The primary returns revision 8.",
            "This matches the saved change."
          ],
          "actions": [
            {
              "type": "send",
              "to": "app",
              "label": "REVISION 8",
              "delay": 0,
              "from": "p"
            },
            {
              "type": "state",
              "node": "app",
              "text": "v8 = expected v8",
              "color": "ok",
              "delay": 2
            }
          ],
          "time": 14
        },
        {
          "lines": [
            "Match the observation to the decision.",
            "A successful query alone is not enough."
          ],
          "actions": [],
          "time": 21
        }
      ]
    },
    {
      "title": "Received is not applied",
      "nodes": [
        {
          "id": "p",
          "label": "PRIMARY",
          "state": "revision 8"
        },
        {
          "id": "r",
          "label": "REPLICA",
          "state": "revision 7"
        }
      ],
      "intro": "PostgreSQL sends write-ahead log records to standbys. Receiving or flushing those records differs from replaying them into query-visible state.",
      "takeaway": "What an acknowledgement proves depends on the configured replication mode. Do not equate received bytes with a query seeing the change.",
      "duration": 28,
      "beats": [
        {
          "lines": [
            "The primary sends a change record.",
            "The replica receives the record."
          ],
          "actions": [
            {
              "type": "send",
              "to": "r",
              "label": "WAL v8",
              "delay": 0,
              "from": "p"
            },
            {
              "type": "state",
              "node": "r",
              "text": "received v8",
              "color": "accent",
              "delay": 2
            }
          ],
          "time": 0
        },
        {
          "lines": [
            "Receipt does not mean replay finished.",
            "Queries may still observe revision 7."
          ],
          "actions": [
            {
              "type": "state",
              "node": "r",
              "text": "received v8; reads v7",
              "color": "accent",
              "delay": 0
            }
          ],
          "time": 7
        },
        {
          "lines": [
            "The replica replays the change.",
            "Its query-visible state advances."
          ],
          "actions": [
            {
              "type": "work",
              "node": "r",
              "duration": 5,
              "delay": 0
            }
          ],
          "time": 14
        },
        {
          "lines": [
            "Now a fresh query can see revision 8.",
            "Check what your acknowledgement means."
          ],
          "actions": [
            {
              "type": "state",
              "node": "r",
              "text": "query sees v8",
              "color": "ok",
              "delay": 0
            }
          ],
          "time": 21
        }
      ]
    },
    {
      "title": "Failover can lose data",
      "nodes": [
        {
          "id": "app",
          "label": "APPLICATION",
          "state": "write acknowledged"
        },
        {
          "id": "p",
          "label": "PRIMARY",
          "state": "revision 8"
        },
        {
          "id": "r",
          "label": "NODE B",
          "state": "standby: revision 7"
        }
      ],
      "intro": "If an asynchronous primary fails before a recent change reaches the standby, promoting that standby can lose the acknowledged change.",
      "takeaway": "Replication modes trade latency, availability and durability. This illustrates an asynchronous failure window, not every replication configuration.",
      "duration": 28,
      "beats": [
        {
          "lines": [
            "Async replication: v8 was acknowledged.",
            "The standby only has revision 7."
          ],
          "actions": [],
          "time": 0
        },
        {
          "lines": [
            "The primary fails before shipping v8.",
            "Its newest change is absent elsewhere."
          ],
          "actions": [
            {
              "type": "state",
              "node": "p",
              "text": "unavailable",
              "color": "bad",
              "delay": 0
            }
          ],
          "time": 7
        },
        {
          "lines": [
            "The standby is promoted.",
            "It can serve the data it actually has."
          ],
          "actions": [
            {
              "type": "state",
              "node": "r",
              "text": "new primary: v7",
              "color": "accent",
              "delay": 0
            }
          ],
          "time": 14
        },
        {
          "lines": [
            "Revision 8 is missing after failover.",
            "Choose durability requirements explicitly."
          ],
          "actions": [
            {
              "type": "send",
              "to": "r",
              "label": "READ",
              "delay": 0,
              "from": "app"
            },
            {
              "type": "send",
              "to": "app",
              "label": "v7",
              "delay": 3,
              "from": "r"
            },
            {
              "type": "state",
              "node": "app",
              "text": "v8 missing",
              "color": "bad",
              "delay": 5
            }
          ],
          "time": 21
        }
      ]
    }
  ]
}
