{
  "concept": "loop-engineering",
  "authored": "2026-10-20",
  "sources": [
    {
      "title": "Anthropic: feedback, stopping, and human review",
      "url": "https://www.anthropic.com/engineering/building-effective-agents",
      "retrieved": "2026-10-19"
    },
    {
      "title": "pytest exit codes",
      "url": "https://docs.pytest.org/en/stable/reference/exit-codes.html",
      "retrieved": "2026-10-19"
    },
    {
      "title": "pytest test selection and collection",
      "url": "https://docs.pytest.org/en/stable/how-to/usage.html",
      "retrieved": "2026-10-19"
    },
    {
      "title": "pytest flaky tests",
      "url": "https://docs.pytest.org/en/stable/explanation/flaky.html",
      "retrieved": "2026-10-19"
    },
    {
      "title": "Amazon Builders\u2019 Library: timeouts and retries",
      "url": "https://aws.amazon.com/builders-library/timeouts-retries-and-backoff-with-jitter/",
      "retrieved": "2026-10-19"
    }
  ],
  "lessons": [
    {
      "title": "Act, observe, decide",
      "nodes": [
        {
          "id": "agent",
          "label": "AGENT",
          "state": ""
        },
        {
          "id": "tool",
          "label": "TOOL",
          "state": ""
        },
        {
          "id": "control",
          "label": "LOOP CONTROLLER",
          "state": ""
        }
      ],
      "intro": "An agent loop alternates an action, an observation and a decision about what to do next. The controller enforces continuation and stopping rules.",
      "takeaway": "A loop requires evidence and boundaries; repeated prompting alone does not enforce them.",
      "duration": 28,
      "beats": [
        {
          "lines": [
            "The agent proposes an action.",
            "The tool executes the permitted operation."
          ],
          "actions": [
            {
              "type": "send",
              "to": "tool",
              "label": "ACTION",
              "delay": 0,
              "from": "agent"
            },
            {
              "type": "work",
              "node": "tool",
              "duration": 4,
              "delay": 2
            }
          ],
          "time": 0
        },
        {
          "lines": [
            "The tool returns an observation.",
            "The controller receives actual evidence."
          ],
          "actions": [
            {
              "type": "send",
              "to": "control",
              "label": "RESULT",
              "delay": 0,
              "from": "tool"
            }
          ],
          "time": 7
        },
        {
          "lines": [
            "The controller checks the stopping rules.",
            "It decides whether another step is allowed."
          ],
          "actions": [
            {
              "type": "state",
              "node": "control",
              "text": "evaluate result",
              "color": "accent",
              "delay": 0
            }
          ],
          "time": 14
        },
        {
          "lines": [
            "If allowed, another action can follow.",
            "The cycle has an explicit decision point."
          ],
          "actions": [
            {
              "type": "send",
              "to": "agent",
              "label": "CONTINUE",
              "delay": 0,
              "from": "control"
            }
          ],
          "time": 21
        }
      ]
    },
    {
      "title": "Use a specific failure",
      "nodes": [
        {
          "id": "agent",
          "label": "AGENT",
          "state": ""
        },
        {
          "id": "tests",
          "label": "TEST RUNNER",
          "state": ""
        },
        {
          "id": "patch",
          "label": "CODE",
          "state": ""
        }
      ],
      "intro": "A discount-calculation test fails with a concrete assertion. The agent can connect that observation to a targeted code change.",
      "takeaway": "A failing assertion is useful only when the relevant tests actually ran. Preserve the failing input and expected behavior.",
      "duration": 28,
      "beats": [
        {
          "lines": [
            "Twelve tests run against the code.",
            "One assertion fails."
          ],
          "actions": [
            {
              "type": "work",
              "node": "tests",
              "duration": 4,
              "delay": 0
            },
            {
              "type": "state",
              "node": "tests",
              "text": "11 pass, 1 fail",
              "color": "bad",
              "delay": 4
            }
          ],
          "time": 0
        },
        {
          "lines": [
            "Send the failing assertion to the agent.",
            "It shows expected and actual behavior."
          ],
          "actions": [
            {
              "type": "send",
              "to": "agent",
              "label": "90 \u2260 100",
              "delay": 0,
              "from": "tests"
            },
            {
              "type": "state",
              "node": "tests",
              "text": "expected 90, got 100",
              "color": "bad",
              "delay": 0
            }
          ],
          "time": 7
        },
        {
          "lines": [
            "The agent makes a targeted repair.",
            "The code changes; the evidence is now old."
          ],
          "actions": [
            {
              "type": "send",
              "to": "patch",
              "label": "PATCH",
              "delay": 0,
              "from": "agent"
            },
            {
              "type": "state",
              "node": "patch",
              "text": "needs retest",
              "color": "accent",
              "delay": 2
            },
            {
              "type": "state",
              "node": "tests",
              "text": "not yet rerun",
              "color": "accent",
              "delay": 2
            }
          ],
          "time": 14
        },
        {
          "lines": [
            "Return the changed code to the runner.",
            "The next observation must be fresh."
          ],
          "actions": [
            {
              "type": "send",
              "to": "tests",
              "label": "RETEST",
              "delay": 0,
              "from": "patch"
            },
            {
              "type": "state",
              "node": "tests",
              "text": "new run pending",
              "color": "accent",
              "delay": 2
            }
          ],
          "time": 21
        }
      ]
    },
    {
      "title": "Stop after verified success",
      "nodes": [
        {
          "id": "patch",
          "label": "PATCH",
          "state": ""
        },
        {
          "id": "tests",
          "label": "TEST RUNNER",
          "state": ""
        },
        {
          "id": "control",
          "label": "LOOP CONTROLLER",
          "state": ""
        }
      ],
      "intro": "The repaired code runs through the selected suite again. When the configured success criteria are met, the edit loop stops and hands over evidence.",
      "takeaway": "Passing this suite supports the tested behavior. It does not establish that all possible behavior is correct.",
      "duration": 28,
      "beats": [
        {
          "lines": [
            "Run the same relevant checks again.",
            "This time, test the repaired revision."
          ],
          "actions": [
            {
              "type": "send",
              "to": "tests",
              "label": "RUN 12 TESTS",
              "delay": 0,
              "from": "patch"
            },
            {
              "type": "work",
              "node": "tests",
              "duration": 4,
              "delay": 2
            }
          ],
          "time": 0
        },
        {
          "lines": [
            "All twelve selected tests pass.",
            "The runner reports what actually ran."
          ],
          "actions": [
            {
              "type": "state",
              "node": "tests",
              "text": "12 pass",
              "color": "ok",
              "delay": 0
            }
          ],
          "time": 7
        },
        {
          "lines": [
            "The controller checks the success rule.",
            "The observed result satisfies this rule."
          ],
          "actions": [
            {
              "type": "send",
              "to": "control",
              "label": "12 PASSED",
              "delay": 0,
              "from": "tests"
            },
            {
              "type": "state",
              "node": "control",
              "text": "success rule met",
              "color": "ok",
              "delay": 2
            }
          ],
          "time": 14
        },
        {
          "lines": [
            "Stop editing and hand over the evidence.",
            "Unrequested edits add uncertainty."
          ],
          "actions": [
            {
              "type": "state",
              "node": "control",
              "text": "stop + handoff",
              "color": "ok",
              "delay": 0
            }
          ],
          "time": 21
        }
      ]
    },
    {
      "title": "No tests is not a pass",
      "nodes": [
        {
          "id": "agent",
          "label": "AGENT",
          "state": ""
        },
        {
          "id": "tests",
          "label": "TEST RUNNER",
          "state": ""
        },
        {
          "id": "human",
          "label": "ENGINEER",
          "state": ""
        }
      ],
      "intro": "A mistyped test selector can select zero tests. Under this repair-only policy, the agent stops rather than treating the empty run as proof of correctness.",
      "takeaway": "Distinguish assertion failure, collection errors and no tests selected. They require different next actions.",
      "duration": 28,
      "beats": [
        {
          "lines": [
            "A selector matches no tests.",
            "No behavior has been checked."
          ],
          "actions": [
            {
              "type": "state",
              "node": "tests",
              "text": "0 selected",
              "color": "bad",
              "delay": 0
            }
          ],
          "time": 0
        },
        {
          "lines": [
            "The runner returns that empty selection.",
            "The agent cannot call it a passing suite."
          ],
          "actions": [
            {
              "type": "send",
              "to": "agent",
              "label": "NO TESTS",
              "delay": 0,
              "from": "tests"
            },
            {
              "type": "state",
              "node": "agent",
              "text": "evidence missing",
              "color": "bad",
              "delay": 2
            }
          ],
          "time": 7
        },
        {
          "lines": [
            "This policy stops further code edits.",
            "Keep the command and selection output."
          ],
          "actions": [
            {
              "type": "state",
              "node": "agent",
              "text": "stop edits",
              "color": "accent",
              "delay": 0
            }
          ],
          "time": 14
        },
        {
          "lines": [
            "Hand the evidence to an engineer.",
            "Repair the test setup before continuing."
          ],
          "actions": [
            {
              "type": "send",
              "to": "human",
              "label": "COMMAND + LOG",
              "delay": 0,
              "from": "agent"
            }
          ],
          "time": 21
        }
      ]
    },
    {
      "title": "Limit repair attempts",
      "nodes": [
        {
          "id": "agent",
          "label": "AGENT",
          "state": ""
        },
        {
          "id": "control",
          "label": "LOOP CONTROLLER",
          "state": "1 attempt left"
        },
        {
          "id": "human",
          "label": "ENGINEER",
          "state": ""
        }
      ],
      "intro": "A controller can cap time, tool calls or repair attempts. Repeated unproductive failures should lead to a useful handoff rather than an endless loop.",
      "takeaway": "The controller must enforce the budget outside the model. A handoff should explain what was tried and what still fails.",
      "duration": 28,
      "beats": [
        {
          "lines": [
            "The task has a configured attempt budget.",
            "The controller counts completed attempts."
          ],
          "actions": [],
          "time": 0
        },
        {
          "lines": [
            "Another repair attempt still fails.",
            "The remaining allowance decreases."
          ],
          "actions": [
            {
              "type": "send",
              "to": "control",
              "label": "FAILED ATTEMPT",
              "delay": 0,
              "from": "agent"
            },
            {
              "type": "state",
              "node": "control",
              "text": "0 attempts left",
              "color": "bad",
              "delay": 2
            }
          ],
          "time": 7
        },
        {
          "lines": [
            "The budget is exhausted.",
            "The controller blocks another edit cycle."
          ],
          "actions": [
            {
              "type": "state",
              "node": "control",
              "text": "continuation denied",
              "color": "bad",
              "delay": 0
            }
          ],
          "time": 14
        },
        {
          "lines": [
            "Send the remaining failure and evidence.",
            "A human can choose a new approach."
          ],
          "actions": [
            {
              "type": "send",
              "to": "human",
              "label": "HANDOFF",
              "delay": 0,
              "from": "control"
            }
          ],
          "time": 21
        }
      ]
    }
  ]
}
