{
  "concept": "orchestration-patterns",
  "authored": "2026-10-20",
  "sources": [
    {
      "title": "Anthropic: Building effective agents \u2014 pattern definitions and tradeoffs",
      "url": "https://www.anthropic.com/engineering/building-effective-agents",
      "retrieved": "2026-10-19"
    },
    {
      "title": "GitHub: Using jobs in a workflow \u2014 prerequisite success and exceptions",
      "url": "https://docs.github.com/en/actions/how-tos/write-workflows/choose-what-workflows-do/use-jobs",
      "retrieved": "2026-10-19"
    },
    {
      "title": "GitHub: Authenticate with GITHUB_TOKEN \u2014 explicit permission configuration",
      "url": "https://docs.github.com/en/actions/tutorials/authenticate-with-github_token",
      "retrieved": "2026-10-19"
    }
  ],
  "lessons": [
    {
      "title": "Follow dependencies",
      "nodes": [
        {
          "id": "draft",
          "label": "DRAFT STEP",
          "state": ""
        },
        {
          "id": "check",
          "label": "CHECK STEP",
          "state": ""
        },
        {
          "id": "result",
          "label": "FINAL RESULT",
          "state": ""
        }
      ],
      "intro": "A chain runs dependent steps in order. Checking a draft requires that draft to exist, so these two steps cannot run independently.",
      "takeaway": "Use a chain when later work depends on an earlier result. Extra steps add latency and new failure points.",
      "duration": 28,
      "beats": [
        {
          "lines": [
            "First produce the draft.",
            "The check needs that output."
          ],
          "actions": [
            {
              "type": "work",
              "node": "draft",
              "duration": 5,
              "delay": 0
            }
          ],
          "time": 0
        },
        {
          "lines": [
            "Send the draft to the checking step.",
            "The dependency is now available."
          ],
          "actions": [
            {
              "type": "send",
              "to": "check",
              "label": "DRAFT",
              "delay": 0,
              "from": "draft"
            },
            {
              "type": "state",
              "node": "check",
              "text": "input ready",
              "color": "ok",
              "delay": 2
            }
          ],
          "time": 7
        },
        {
          "lines": [
            "Check the draft against the criteria.",
            "Keep the observed findings."
          ],
          "actions": [
            {
              "type": "work",
              "node": "check",
              "duration": 5,
              "delay": 0
            }
          ],
          "time": 14
        },
        {
          "lines": [
            "Build the result from checked work.",
            "Order follows the data dependency."
          ],
          "actions": [
            {
              "type": "send",
              "to": "result",
              "label": "FINDINGS",
              "delay": 0,
              "from": "check"
            },
            {
              "type": "state",
              "node": "check",
              "text": "check complete",
              "color": "ok",
              "delay": 0
            },
            {
              "type": "state",
              "node": "result",
              "text": "contract preserved",
              "color": "ok",
              "delay": 2
            }
          ],
          "time": 21
        }
      ]
    },
    {
      "title": "Route to one specialist",
      "nodes": [
        {
          "id": "router",
          "label": "REQUEST ROUTER",
          "state": "API compatibility"
        },
        {
          "id": "worker",
          "label": "API REVIEWER",
          "state": ""
        },
        {
          "id": "other",
          "label": "DB REVIEWER",
          "state": ""
        },
        {
          "id": "fallback",
          "label": "HUMAN TRIAGE",
          "state": ""
        }
      ],
      "intro": "Routing selects a path based on the request. An API compatibility question goes to the reviewer equipped for that work.",
      "takeaway": "A route is a choice, not proof that the chosen worker will be correct. Ambiguous requests need a fallback.",
      "duration": 28,
      "beats": [
        {
          "lines": [
            "The request concerns API compatibility.",
            "Not every specialist needs to run."
          ],
          "actions": [],
          "time": 0
        },
        {
          "lines": [
            "A router chooses the relevant path.",
            "It uses the request and routing criteria."
          ],
          "actions": [
            {
              "type": "state",
              "node": "router",
              "text": "API path",
              "color": "accent",
              "delay": 2
            },
            {
              "type": "state",
              "node": "other",
              "text": "not selected",
              "color": "accent",
              "delay": 0
            }
          ],
          "time": 7
        },
        {
          "lines": [
            "Send the task to the API reviewer.",
            "Its tools and instructions fit that scope."
          ],
          "actions": [
            {
              "type": "send",
              "to": "worker",
              "label": "REVIEW API",
              "delay": 0,
              "from": "router"
            },
            {
              "type": "state",
              "node": "worker",
              "text": "working",
              "color": "accent",
              "delay": 2
            }
          ],
          "time": 14
        },
        {
          "lines": [
            "A new request has unclear scope.",
            "Send it to human triage instead."
          ],
          "actions": [
            {
              "type": "state",
              "node": "router",
              "text": "unclear new request",
              "color": "accent",
              "delay": 0
            },
            {
              "type": "state",
              "node": "worker",
              "text": "previous task done",
              "color": "ok",
              "delay": 0
            },
            {
              "type": "send",
              "to": "fallback",
              "label": "TRIAGE",
              "delay": 1,
              "from": "router"
            },
            {
              "type": "state",
              "node": "fallback",
              "text": "review scope",
              "color": "accent",
              "delay": 3
            }
          ],
          "time": 21
        }
      ]
    },
    {
      "title": "Independent parallel work",
      "nodes": [
        {
          "id": "snapshot",
          "label": "CODE SNAPSHOT",
          "state": "revision r42"
        },
        {
          "id": "api",
          "label": "API REVIEW",
          "state": ""
        },
        {
          "id": "db",
          "label": "MIGRATION",
          "state": ""
        },
        {
          "id": "join",
          "label": "COORDINATOR",
          "state": ""
        }
      ],
      "intro": "Two read-only reviews can inspect different concerns in the same code snapshot. Their analyses are independent, so they can overlap.",
      "takeaway": "Parallel work is appropriate when tasks do not depend on each other or mutate shared state unsafely.",
      "duration": 28,
      "beats": [
        {
          "lines": [
            "Freeze one code snapshot.",
            "Both reviewers must inspect that revision."
          ],
          "actions": [],
          "time": 0
        },
        {
          "lines": [
            "Assign compatibility and migration reviews.",
            "These analyses can run independently."
          ],
          "actions": [
            {
              "type": "send",
              "to": "api",
              "label": "API TASK",
              "delay": 0,
              "from": "snapshot"
            },
            {
              "type": "send",
              "to": "db",
              "label": "DB TASK",
              "delay": 2,
              "from": "snapshot"
            }
          ],
          "time": 7
        },
        {
          "lines": [
            "Both reviewers inspect the code.",
            "Neither edits shared files."
          ],
          "actions": [
            {
              "type": "work",
              "node": "api",
              "duration": 5,
              "delay": 0
            },
            {
              "type": "work",
              "node": "db",
              "duration": 5,
              "delay": 0
            }
          ],
          "time": 14
        },
        {
          "lines": [
            "Keep the results tied to the snapshot.",
            "The coordinator will need both reports."
          ],
          "actions": [
            {
              "type": "state",
              "node": "api",
              "text": "report ready",
              "color": "ok",
              "delay": 0
            },
            {
              "type": "state",
              "node": "db",
              "text": "report ready",
              "color": "ok",
              "delay": 0
            }
          ],
          "time": 21
        }
      ]
    },
    {
      "title": "Join before deciding",
      "nodes": [
        {
          "id": "snapshot",
          "label": "CODE SNAPSHOT",
          "state": ""
        },
        {
          "id": "api",
          "label": "API REVIEW",
          "state": "finished"
        },
        {
          "id": "db",
          "label": "MIGRATION",
          "state": "running"
        },
        {
          "id": "join",
          "label": "COORDINATOR",
          "state": "waiting"
        }
      ],
      "intro": "The final assessment depends on both reviews. One early result does not satisfy the join condition.",
      "takeaway": "A coordinator must handle missing, failed or conflicting results. Parallel execution does not remove dependencies at the decision point.",
      "duration": 28,
      "beats": [
        {
          "lines": [
            "In this run, the API review finishes first.",
            "The migration review is still running."
          ],
          "actions": [
            {
              "type": "send",
              "to": "join",
              "label": "API REPORT",
              "delay": 0,
              "from": "api"
            },
            {
              "type": "work",
              "node": "db",
              "duration": 12,
              "delay": 0
            }
          ],
          "time": 0
        },
        {
          "lines": [
            "The coordinator waits for the dependency.",
            "One report cannot stand for both."
          ],
          "actions": [
            {
              "type": "state",
              "node": "join",
              "text": "1 of 2 reports",
              "color": "accent",
              "delay": 0
            }
          ],
          "time": 7
        },
        {
          "lines": [
            "Migration finishes and reports a risk.",
            "Its report travels to the coordinator."
          ],
          "actions": [
            {
              "type": "state",
              "node": "db",
              "text": "risk found",
              "color": "bad",
              "delay": 0
            },
            {
              "type": "send",
              "to": "join",
              "label": "RISK FOUND",
              "delay": 0,
              "from": "db"
            },
            {
              "type": "state",
              "node": "join",
              "text": "2 of 2 reports",
              "color": "accent",
              "delay": 2
            }
          ],
          "time": 14
        },
        {
          "lines": [
            "The migration risk blocks this release.",
            "Two reports do not imply success."
          ],
          "actions": [
            {
              "type": "state",
              "node": "join",
              "text": "release blocked",
              "color": "bad",
              "delay": 0
            }
          ],
          "time": 21
        }
      ]
    },
    {
      "title": "Revise against criteria",
      "nodes": [
        {
          "id": "worker",
          "label": "WORKER",
          "state": ""
        },
        {
          "id": "grader",
          "label": "EVALUATOR",
          "state": ""
        },
        {
          "id": "control",
          "label": "CONTROLLER",
          "state": ""
        }
      ],
      "intro": "An evaluator checks work against explicit criteria. Feedback can drive a revision loop, but the controller must limit iteration and handle uncertain grading.",
      "takeaway": "Evaluation is useful feedback, not infallible truth. Stop when criteria or budgets say to stop.",
      "duration": 28,
      "beats": [
        {
          "lines": [
            "The worker submits a draft.",
            "The evaluator applies explicit criteria."
          ],
          "actions": [
            {
              "type": "send",
              "to": "grader",
              "label": "DRAFT",
              "delay": 0,
              "from": "worker"
            },
            {
              "type": "work",
              "node": "grader",
              "duration": 4,
              "delay": 2
            }
          ],
          "time": 0
        },
        {
          "lines": [
            "The evaluator finds a missing requirement.",
            "Return a specific reason to revise."
          ],
          "actions": [
            {
              "type": "state",
              "node": "grader",
              "text": "rollback case missing",
              "color": "bad",
              "delay": 0
            },
            {
              "type": "send",
              "to": "worker",
              "label": "ADD ROLLBACK",
              "delay": 0,
              "from": "grader"
            },
            {
              "type": "state",
              "node": "worker",
              "text": "add rollback case",
              "color": "accent",
              "delay": 2
            }
          ],
          "time": 7
        },
        {
          "lines": [
            "The worker submits a revised result.",
            "The evaluator checks it again."
          ],
          "actions": [
            {
              "type": "send",
              "to": "grader",
              "label": "REVISION",
              "delay": 0,
              "from": "worker"
            },
            {
              "type": "work",
              "node": "grader",
              "duration": 4,
              "delay": 2
            }
          ],
          "time": 14
        },
        {
          "lines": [
            "The revised example meets the criterion.",
            "Stop this loop after one revision."
          ],
          "actions": [
            {
              "type": "state",
              "node": "grader",
              "text": "rollback case present",
              "color": "ok",
              "delay": 0
            },
            {
              "type": "send",
              "to": "control",
              "label": "CRITERION MET",
              "delay": 0,
              "from": "grader"
            },
            {
              "type": "state",
              "node": "control",
              "text": "stop: 1 revision",
              "color": "ok",
              "delay": 2
            }
          ],
          "time": 21
        }
      ]
    }
  ]
}
